# ==========================================
# muse2api Environment Configuration Example
# Copy to .env to activate: cp .env.example .env
# ==========================================

# Admin & API bearer key (prefixed with m2a_).
# If left empty, a random key will be generated and persisted on first startup.
MUSE2API_KEY=m2a_your_secret_admin_key_here

# Listen address and port (use 0.0.0.0 inside Docker)
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610

# Public base URL for external clients and media links (e.g. https://api.yourdomain.com)
# Leave empty to auto-detect from incoming request headers
MUSE2API_PUBLIC_BASE=

# Chromium executable path
# Linux/Docker: /usr/bin/chromium or /usr/bin/chromium-browser
# Leave empty to auto-detect Chrome/Chromium on macOS/Linux/Windows
MUSE2API_CHROMIUM=/usr/bin/chromium

# Internal Chromium DevTools Protocol (CDP) debugging port
MUSE2API_CDP_PORT=19210

# Generation timeouts (in seconds)
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300

# Maximum concurrent generation tasks (default: 2)
MUSE2API_CONCURRENCY=2

# Whether to run automatic background keepalive for disabled accounts (0=off, 1=on)
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0

# Enable <local_action> XML tool bridge for coding agents (0=off, 1=on)
MUSE2API_TOOL_PROTOCOL=1
